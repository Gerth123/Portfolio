      "background": "rgba(20, 29, 47, 0.78)",
      "hoverFocusBorder": "var(--portfolio-green)",
      "hoverFocusBackground": "rgba(20, 29, 47, 0.9)"
    }
  },
  "inconsistencies": [
    "Poppins 800 is used but no active @font-face registers weight 800.",
