    i010.\u0275\u0275elementStart(146, "li");
    i010.\u0275\u0275text(147, "Verwaltet von: uns");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(148, "li");
    i010.\u0275\u0275text(149, " Zweck: Diese Cookies erm\xF6glichen es uns, Entscheidungen, die Sie bei der Nutzung der Website treffen, zu speichern, z. B. Ihre Anmeldedaten oder Spracheinstellungen. Der Zweck dieser Cookies ist es, Ihnen eine pers\xF6nlichere Erfahrung zu bieten und zu vermeiden, dass Sie Ihre Pr\xE4ferenzen jedes Mal neu eingeben m\xFCssen, wenn Sie die Website nutzen. ");
    i010.\u0275\u0275elementEnd()()()();
    i010.\u0275\u0275elementStart(150, "p");
    i010.\u0275\u0275text(151, " F\xFCr weitere Informationen zu den von uns verwendeten Cookies und Ihren M\xF6glichkeiten bez\xFCglich Cookies besuchen Sie bitte unsere Cookie-Richtlinie oder den Cookie-Bereich unserer Datenschutzrichtlinie. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(152, "h3");
    i010.\u0275\u0275text(153, "Verwendung Ihrer personenbezogenen Daten");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(154, "p");
    i010.\u0275\u0275text(155, " Das Unternehmen kann personenbezogene Daten f\xFCr folgende Zwecke verwenden: ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(156, "ul")(157, "li")(158, "strong");
    i010.\u0275\u0275text(159, "Zur Bereitstellung und Wartung unseres Dienstes");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(160, ", einschlie\xDFlich der \xDCberwachung der Nutzung unseres Dienstes. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(161, "li")(162, "strong");
    i010.\u0275\u0275text(163, "Zur Verwaltung Ihres Kontos:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(164, " zur Verwaltung Ihrer Registrierung als Benutzer des Dienstes. Die von Ihnen bereitgestellten personenbezogenen Daten k\xF6nnen Ihnen Zugriff auf verschiedene Funktionen des Dienstes gew\xE4hren, die Ihnen als registrierter Benutzer zur Verf\xFCgung stehen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(165, "li")(166, "strong");
    i010.\u0275\u0275text(167, "Zur Erf\xFCllung eines Vertrags:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(168, " die Entwicklung, Einhaltung und Durchf\xFChrung des Kaufvertrags f\xFCr die Produkte, Artikel oder Dienstleistungen, die Sie \xFCber den Dienst erworben haben, oder eines anderen Vertrags mit uns \xFCber den Dienst. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(169, "li")(170, "strong");
    i010.\u0275\u0275text(171, "Um Sie zu kontaktieren:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(172, " Um Sie per E-Mail, Telefonanruf, SMS oder anderen gleichwertigen Formen elektronischer Kommunikation zu kontaktieren, wie z. B. Push-Benachrichtigungen einer mobilen Anwendung, bez\xFCglich Updates oder informativen Mitteilungen zu den Funktionen, Produkten oder vertraglichen Dienstleistungen, einschlie\xDFlich Sicherheitsupdates, wenn dies notwendig oder angemessen f\xFCr deren Umsetzung ist. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(173, "li")(174, "strong");
    i010.\u0275\u0275text(175, "Um Ihnen");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(176, " Nachrichten, Sonderangebote und allgemeine Informationen \xFCber andere Waren, Dienstleistungen und Veranstaltungen, die wir anbieten, die \xE4hnlich sind wie die, die Sie bereits erworben oder angefragt haben, zur Verf\xFCgung zu stellen, es sei denn, Sie haben sich entschieden, solche Informationen nicht zu erhalten. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(177, "li")(178, "strong");
    i010.\u0275\u0275text(179, "Zur Verwaltung Ihrer Anfragen:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(180, " Um Ihre Anfragen an uns zu bearbeiten und zu verwalten. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(181, "li")(182, "strong");
    i010.\u0275\u0275text(183, "F\xFCr Unternehmens\xFCbertragungen:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(184, " Wir k\xF6nnen Ihre Informationen verwenden, um eine Fusion, Ver\xE4u\xDFertung, Umstrukturierung, Reorganisation, Aufl\xF6sung oder einen anderen Verkauf oder Transfer eines Teils oder aller unserer Verm\xF6genswerte zu bewerten oder durchzuf\xFChren, unabh\xE4ngig davon, ob es sich um einen fortlaufenden Gesch\xE4ftsbetrieb oder um Insolvenz, Liquidation oder ein \xE4hnliches Verfahren handelt, bei dem personenbezogene Daten, die wir \xFCber unsere Dienstnutzer gespeichert haben, zu den \xFCbertragenen Verm\xF6genswerten geh\xF6ren. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(185, "li")(186, "strong");
    i010.\u0275\u0275text(187, "F\xFCr andere Zwecke:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(188, " Wir k\xF6nnen Ihre Informationen f\xFCr andere Zwecke verwenden, wie z. B. Datenanalyse, Identifizierung von Nutzungstrends, Bestimmung der Effektivit\xE4t unserer Werbekampagnen und zur Bewertung und Verbesserung unseres Dienstes, unserer Produkte, Dienstleistungen, unseres Marketings und Ihrer Erfahrung. ");
    i010.\u0275\u0275elementEnd()();
    i010.\u0275\u0275elementStart(189, "p");
    i010.\u0275\u0275text(190, " Wir k\xF6nnen Ihre personenbezogenen Informationen in folgenden Situationen teilen: ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(191, "ul")(192, "li")(193, "strong");
    i010.\u0275\u0275text(194, "Mit Dienstanbietern:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(195, " Wir k\xF6nnen Ihre personenbezogenen Informationen mit Dienstanbietern teilen, um die Nutzung unseres Dienstes zu \xFCberwachen und zu analysieren sowie um Sie zu kontaktieren. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(196, "li")(197, "strong");
    i010.\u0275\u0275text(198, "F\xFCr Unternehmens\xFCbertragungen:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(199, " Wir k\xF6nnen Ihre personenbezogenen Informationen im Zusammenhang mit oder w\xE4hrend der Verhandlungen zu einer Fusion, dem Verkauf von Unternehmensverm\xF6gen, der Finanzierung oder der \xDCbernahme eines Teils oder der gesamten unserer Gesch\xE4fte an ein anderes Unternehmen weitergeben oder \xFCbertragen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(200, "li")(201, "strong");
    i010.\u0275\u0275text(202, "Mit Partnerunternehmen:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(203, " Wir k\xF6nnen Ihre Informationen mit unseren Partnerunternehmen teilen, in diesem Fall werden wir diese Partnerunternehmen verpflichten, diese Datenschutzrichtlinie einzuhalten. Partnerunternehmen umfassen unser Mutterunternehmen sowie andere Tochtergesellschaften, Joint-Venture-Partner oder andere Unternehmen, die wir kontrollieren oder die unter gemeinsamer Kontrolle mit uns stehen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(204, "li")(205, "strong");
    i010.\u0275\u0275text(206, "Mit Gesch\xE4ftspartnern:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(207, " Wir k\xF6nnen Ihre Informationen mit unseren Gesch\xE4ftspartnern teilen, um Ihnen bestimmte Produkte, Dienstleistungen oder Aktionen anzubieten. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(208, "li")(209, "strong");
    i010.\u0275\u0275text(210, "Mit anderen Nutzern:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(211, " Wenn Sie personenbezogene Informationen teilen oder anderweitig in \xF6ffentlichen Bereichen mit anderen Nutzern interagieren, k\xF6nnen solche Informationen von allen Nutzern gesehen werden und au\xDFerhalb \xF6ffentlich verbreitet werden. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(212, "li")(213, "strong");
    i010.\u0275\u0275text(214, "Mit Ihrer Zustimmung:");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275text(215, " Wir k\xF6nnen Ihre personenbezogenen Informationen zu jedem anderen Zweck mit Ihrer Zustimmung offenlegen. ");
    i010.\u0275\u0275elementEnd()();
    i010.\u0275\u0275elementStart(216, "h3");
    i010.\u0275\u0275text(217, "Aufbewahrung Ihrer personenbezogenen Daten");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(218, "p");
    i010.\u0275\u0275text(219, " Das Unternehmen wird Ihre personenbezogenen Daten nur so lange aufbewahren, wie es f\xFCr die in dieser Datenschutzrichtlinie festgelegten Zwecke erforderlich ist. Wir werden Ihre personenbezogenen Daten aufbewahren und nutzen, soweit dies erforderlich ist, um unseren gesetzlichen Verpflichtungen nachzukommen (z. B. wenn wir verpflichtet sind, Ihre Daten aufzubewahren, um geltenden Gesetzen zu entsprechen), Streitigkeiten zu kl\xE4ren und unsere rechtlichen Vereinbarungen und Richtlinien durchzusetzen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(220, "p");
    i010.\u0275\u0275text(221, " Das Unternehmen wird auch Nutzungsdaten zu internen Analysezwecken aufbewahren. Nutzungsdaten werden in der Regel f\xFCr einen k\xFCrzeren Zeitraum aufbewahrt, es sei denn, diese Daten werden verwendet, um die Sicherheit zu erh\xF6hen oder die Funktionalit\xE4t unseres Dienstes zu verbessern, oder wir sind rechtlich verpflichtet, diese Daten f\xFCr l\xE4ngere Zeitr\xE4ume aufzubewahren. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(222, "h3");
    i010.\u0275\u0275text(223, "\xDCbertragung Ihrer personenbezogenen Daten");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(224, "p");
    i010.\u0275\u0275text(225, " Ihre Informationen, einschlie\xDFlich personenbezogener Daten, werden in den Betriebsb\xFCros des Unternehmens und an jedem anderen Ort verarbeitet, an dem die an der Verarbeitung beteiligten Parteien ihren Sitz haben. Das bedeutet, dass diese Informationen an Computer \xFCbertragen und dort gespeichert werden k\xF6nnen, die sich au\xDFerhalb Ihres Bundesstaates, Ihrer Provinz, Ihres Landes oder einer anderen staatlichen Jurisdiktion befinden, in der die Datenschutzgesetze von denen Ihrer Jurisdiktion abweichen k\xF6nnen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(226, "p");
    i010.\u0275\u0275text(227, " Ihre Zustimmung zu dieser Datenschutzrichtlinie, gefolgt von Ihrer \xDCbermittlung solcher Informationen, stellt Ihre Zustimmung zu dieser \xDCbertragung dar. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(228, "p");
    i010.\u0275\u0275text(229, " Das Unternehmen wird alle angemessenen Schritte unternehmen, um sicherzustellen, dass Ihre Daten sicher und in \xDCbereinstimmung mit dieser Datenschutzrichtlinie behandelt werden, und es wird keine \xDCbertragung Ihrer personenbezogenen Daten an eine Organisation oder ein Land stattfinden, es sei denn, es bestehen angemessene Kontrollen, einschlie\xDFlich der Sicherheit Ihrer Daten und anderer pers\xF6nlicher Informationen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(230, "h3");
    i010.\u0275\u0275text(231, "Ihre personenbezogenen Daten l\xF6schen");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(232, "p");
    i010.\u0275\u0275text(233, " Sie haben das Recht, Ihre personenbezogenen Daten zu l\xF6schen oder zu beantragen, dass wir Ihnen dabei helfen, die personenbezogenen Daten zu l\xF6schen, die wir \xFCber Sie gesammelt haben. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(234, "p");
    i010.\u0275\u0275text(235, " Unser Dienst kann Ihnen die M\xF6glichkeit geben, bestimmte Informationen \xFCber Sie aus dem Dienst zu l\xF6schen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(236, "p");
    i010.\u0275\u0275text(237, " Sie k\xF6nnen Ihre Informationen jederzeit aktualisieren, \xE4ndern oder l\xF6schen, indem Sie sich in Ihr Konto einloggen, falls Sie eines haben, und den Abschnitt zur Kontoeinstellungen besuchen, der es Ihnen erm\xF6glicht, Ihre personenbezogenen Daten zu verwalten. Sie k\xF6nnen uns auch kontaktieren, um Zugang zu, Korrektur von oder L\xF6schung von personenbezogenen Informationen zu beantragen, die Sie uns zur Verf\xFCgung gestellt haben. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(238, "p");
    i010.\u0275\u0275text(239, " Bitte beachten Sie jedoch, dass wir bestimmte Informationen m\xF6glicherweise aufbewahren m\xFCssen, wenn wir eine gesetzliche Verpflichtung oder einen rechtlichen Grund dazu haben. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(240, "h3");
    i010.\u0275\u0275text(241, "Offenlegung Ihrer personenbezogenen Daten");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(242, "h4");
    i010.\u0275\u0275text(243, "Unternehmensgesch\xE4fte");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(244, "p");
    i010.\u0275\u0275text(245, " Wenn das Unternehmen an einer Fusion, \xDCbernahme oder einem Verm\xF6gensverkauf beteiligt ist, k\xF6nnen Ihre personenbezogenen Daten \xFCbertragen werden. Wir werden eine Mitteilung bereitstellen, bevor Ihre personenbezogenen Daten \xFCbertragen werden und einer anderen Datenschutzrichtlinie unterliegen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(246, "h2");
    i010.\u0275\u0275text(247, "Gesetzliche Anforderungen");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(248, "p");
    i010.\u0275\u0275text(249, " Unter bestimmten Umst\xE4nden kann das Unternehmen verpflichtet sein, Ihre personenbezogenen Daten offenzulegen, wenn dies gesetzlich erforderlich ist oder auf g\xFCltige Anfragen von \xF6ffentlichen Beh\xF6rden (z. B. einem Gericht oder einer Regierungsbeh\xF6rde) reagiert wird. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(250, "h2");
    i010.\u0275\u0275text(251, "Weitere gesetzliche Anforderungen");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(252, "p");
    i010.\u0275\u0275text(253, " Das Unternehmen kann Ihre personenbezogenen Daten in dem guten Glauben offenlegen, dass eine solche Ma\xDFnahme erforderlich ist, um: ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(254, "ul")(255, "li");
    i010.\u0275\u0275text(256, "Eine gesetzliche Verpflichtung zu erf\xFCllen");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(257, "li");
    i010.\u0275\u0275text(258, " Die Rechte oder das Eigentum des Unternehmens zu sch\xFCtzen und zu verteidigen ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(259, "li");
    i010.\u0275\u0275text(260, " Eine m\xF6gliche Straftat in Verbindung mit dem Dienst zu verhindern oder zu untersuchen ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(261, "li");
    i010.\u0275\u0275text(262, " Die pers\xF6nliche Sicherheit der Nutzer des Dienstes oder der \xD6ffentlichkeit zu sch\xFCtzen ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(263, "li");
    i010.\u0275\u0275text(264, "Rechtliche Haftung zu vermeiden");
    i010.\u0275\u0275elementEnd()();
    i010.\u0275\u0275elementStart(265, "h2");
    i010.\u0275\u0275text(266, "Sicherheit Ihrer personenbezogenen Daten");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(267, "p");
    i010.\u0275\u0275text(268, " Die Sicherheit Ihrer personenbezogenen Daten ist uns wichtig, aber denken Sie daran, dass keine Methode der \xDCbertragung \xFCber das Internet oder eine Methode der elektronischen Speicherung 100 % sicher ist. W\xE4hrend wir uns bem\xFChen, kommerziell akzeptable Mittel zum Schutz Ihrer personenbezogenen Daten zu verwenden, k\xF6nnen wir deren absolute Sicherheit nicht garantieren. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(269, "h2");
    i010.\u0275\u0275text(270, "Datenschutz von Kindern");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(271, "p");
    i010.\u0275\u0275text(272, " Unser Dienst richtet sich nicht an Personen unter 13 Jahren. Wir erheben nicht wissentlich personenbezogene Informationen von Personen unter 13 Jahren. Wenn Sie ein Elternteil oder ein Erziehungsberechtigter sind und Sie wissen, dass Ihr Kind uns personenbezogene Daten zur Verf\xFCgung gestellt hat, kontaktieren Sie uns bitte. Wenn wir feststellen, dass wir personenbezogene Daten von jemandem unter 13 Jahren ohne \xDCberpr\xFCfung der elterlichen Zustimmung gesammelt haben, ergreifen wir Ma\xDFnahmen, um diese Informationen von unseren Servern zu entfernen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(273, "p");
    i010.\u0275\u0275text(274, " Wenn wir uns auf die Zustimmung als rechtliche Grundlage f\xFCr die Verarbeitung Ihrer Informationen verlassen m\xFCssen und Ihr Land die Zustimmung eines Elternteils erfordert, k\xF6nnen wir die Zustimmung Ihres Elternteils anfordern, bevor wir diese Informationen sammeln und verwenden. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(275, "h2");
    i010.\u0275\u0275text(276, "Links zu anderen Websites");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(277, "p");
    i010.\u0275\u0275text(278, " Unser Dienst kann Links zu anderen Websites enthalten, die nicht von uns betrieben werden. Wenn Sie auf einen Link eines Drittanbieters klicken, werden Sie zu dieser Drittanbieter-Website weitergeleitet. Wir empfehlen Ihnen dringend, die Datenschutzrichtlinie jeder Website zu \xFCberpr\xFCfen, die Sie besuchen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(279, "p");
    i010.\u0275\u0275text(280, " Wir haben keine Kontrolle \xFCber und \xFCbernehmen keine Verantwortung f\xFCr den Inhalt, die Datenschutzrichtlinien oder die Praktiken von Drittanbieterdiensten oder -websites. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(281, "h2");
    i010.\u0275\u0275text(282, "\xC4nderungen dieser Datenschutzrichtlinie");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(283, "p");
    i010.\u0275\u0275text(284, " Wir k\xF6nnen unsere Datenschutzrichtlinie von Zeit zu Zeit aktualisieren. Wir werden Sie \xFCber \xC4nderungen informieren, indem wir die neue Datenschutzrichtlinie auf dieser Seite ver\xF6ffentlichen. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(285, "p");
    i010.\u0275\u0275text(286, ' Wir werden Sie per E-Mail und/oder durch eine auff\xE4llige Mitteilung auf unserem Dienst informieren, bevor die \xC4nderung wirksam wird, und das Datum "Zuletzt aktualisiert" am Anfang dieser Datenschutzrichtlinie aktualisieren. ');
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(287, "p");
    i010.\u0275\u0275text(288, " Es wird empfohlen, diese Datenschutzrichtlinie regelm\xE4\xDFig auf \xC4nderungen zu \xFCberpr\xFCfen. \xC4nderungen an dieser Datenschutzrichtlinie sind wirksam, wenn sie auf dieser Seite ver\xF6ffentlicht werden. ");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(289, "h2");
    i010.\u0275\u0275text(290, "Kontaktieren Sie uns");
    i010.\u0275\u0275elementEnd();
    i010.\u0275\u0275elementStart(291, "p");
    i010.\u0275\u0275text(292, " Wenn Sie Fragen zu dieser Datenschutzrichtlinie haben, k\xF6nnen Sie uns kontaktieren: ");
    i010.\u0275\u0275elementEnd();
